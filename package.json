{
  "name": "laural",
  "private": true,
  "version": "0.1.0-alpha.17",
  "description": "Terminal de escritorio con IA local y agentes configurables",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --coverage",
    "test:coverage-policy": "node --test scripts/check-critical-rust-coverage.test.mjs",
    "test:bundle-budget": "node --test scripts/check-bundle-size.test.mjs",
    "test:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lib --html",
    "test:coverage": "npm test && npm run test:coverage-policy && npm run test:bundle-budget && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  }
}
