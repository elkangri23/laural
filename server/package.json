{
  "name": "@laural/sync-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/bundle-passkeys.mjs && tsx watch src/main.ts",
    "build": "node scripts/bundle-passkeys.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server/src/main.js",
    "migrate": "node --env-file-if-exists=.env dist/server/src/migrate.js",
    "status:validate": "node scripts/validate-status.mjs",
    "test": "vitest run",
    "test:postgres": "node scripts/assert-test-database.mjs && vitest run tests/postgres-rate-limit.integration.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "ajv": "^8.17.1",
    "argon2": "^0.44.0",
    "fastify": "^5.12.7",
    "google-auth-library": "^10.9.1",
    "pg": "^8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
