sync.laurafernandezenfermeria.com {
	encode zstd gzip

	route {
		@statusDocument path /status.json
		handle @statusDocument {
			root * /var/lib/laural/status
			header Cache-Control "no-store"
			header X-Content-Type-Options "nosniff"
			file_server
		}

		@statusPage path /status /status.html /status.css /status.js
		@statusRoot path /status
		handle @statusPage {
			root * /opt/laural/current/server/dist/server/web
			rewrite @statusRoot /status.html
			header Cache-Control "no-store"
			header X-Content-Type-Options "nosniff"
			header X-Frame-Options "DENY"
			header Referrer-Policy "no-referrer"
			header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"
			file_server
		}

		handle {
			reverse_proxy 127.0.0.1:8080
		}
	}
}
