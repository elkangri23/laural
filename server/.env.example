DATABASE_URL=postgresql://laural:change-me@127.0.0.1:5432/laural_sync
HOST=127.0.0.1
PORT=8080
RATE_LIMIT_PEPPER=REEMPLAZAR

# La autenticación por correo permanece desactivada hasta configurar Resend.
# Al activarla, define todas las variables en el entorno privado del servicio.
# EMAIL_AUTH_ENABLED=true
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Laural <no-reply@tu-dominio-verificado.example>
# AUTH_PIN_PEPPER=pon-aqui-un-secreto-aleatorio-de-32-bytes-o-mas
# AUTH_RECOVERY_PEPPER=otro-secreto-aleatorio-independiente-de-32-bytes-o-mas
# TOTP_ENCRYPTION_KEY=clave-base64url-independiente-de-32-bytes
# Las passkeys requieren un dominio HTTPS verificado y RP ID coincidente.
# PASSKEYS_ENABLED=true
# PASSKEY_RP_NAME=Laural
# PASSKEY_RP_ID=sync.laurafernandezenfermeria.com
# PASSKEY_ORIGIN=https://sync.laurafernandezenfermeria.com
