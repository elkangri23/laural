# server/.env.example — variables del servicio sync de Laural.
# Copiar a server/.env en el VPS y rellenar con valores reales.
# Los secretos van SOLO en server/.env, nunca en Git (.gitignore).
#
# Valores de lanzamiento según docs/plans/despliegue-sync-vps.md:
#   EMAIL_AUTH_ENABLED=true
#   RESEND_FROM=Laural <noreply@laurafernandezenfermeria.com>
#   GOOGLE_OAUTH_ENABLED, PASSKEYS_ENABLED y ACCOUNT_RECOVERY_ENABLED:
#   dejar comentados / apagados al abrir (decisiones 5 y 7).
DATABASE_URL=postgres://laural:CAMBIAR-ESTA-CONTRASEÑA@db:5432/laural

HOST=127.0.0.1

PORT=8080

RATE_LIMIT_PEPPER=REEMPLAZAR-POR-UN-SECRETO-ALEATORIO-DE-32-BYTES-O-MÁS

# Proxies de confianza para X-Forwarded-For (server/src/config.ts).
# Con nginx en el host y la API en Docker, el peer es la puerta de
# enlace Docker (172.x): sin 172.16.0.0/12 el rate limit vería una
# sola IP para todos los clientes. Por defecto, si se omite, solo
# loopback (127.0.0.1, ::1).
TRUST_PROXY=172.16.0.0/12,127.0.0.1,::1

# Solo para Docker Compose (no las lee el servicio, las lee PostgreSQL).
# POSTGRES_PASSWORD es obligatorio en Compose: si falta, Compose falla
# antes de arrancar. Debe coincidir con la contraseña de DATABASE_URL.
# POSTGRES_USER=laural
# POSTGRES_PASSWORD=CAMBIAR-ESTA-CONTRASEÑA
# POSTGRES_DB=laural

# La autenticación por correo permanece desactivada hasta configurar Resend.
# Al activarla, define todas las variables en el entorno privado del servicio.
# EMAIL_AUTH_ENABLED=true
# RESEND_API_KEY=PON-AQUI-LA-API-KEY-DE-RESEND-DE-SOLO-ENVIO
# RESEND_FROM=Laural <noreply@laurafernandezenfermeria.com>
# AUTH_PIN_PEPPER=pon-aqui-un-secreto-aleatorio-de-32-bytes-o-mas
# AUTH_RECOVERY_PEPPER=otro-secreto-aleatorio-independiente-de-32-bytes-o-mas
# TOTP_ENCRYPTION_KEY=clave-base64url-independiente-de-32-bytes
# Recuperación administrativa desactivada por defecto. Activar solo tras ensayar el flujo completo del runbook.
# Decisión 7 (2026-11-23): APAGADA al abrir. Perder TOTP y códigos = perder la cuenta.
# ACCOUNT_RECOVERY_ENABLED=true
# ACCOUNT_RECOVERY_ADMIN_EMAIL=administrador@tu-dominio.example
# ACCOUNT_RECOVERY_BASE_URL=https://sync.laurafernandezenfermeria.com/auth/recovery
# Las passkeys requieren un dominio HTTPS verificado y RP ID coincidente.
# Decisión 5 (2026-11-23): APAGADAS al abrir; Google y passkeys después.
# PASSKEYS_ENABLED=true
# PASSKEY_RP_NAME=Laural
# PASSKEY_RP_ID=sync.laurafernandezenfermeria.com
# PASSKEY_ORIGIN=https://sync.laurafernandezenfermeria.com
# Google OAuth permanece desactivado hasta configurar credenciales/callback en Google Cloud.
# Decisión 5 (2026-11-23): APAGADO al abrir; Google después.
# GOOGLE_OAUTH_ENABLED=true
# GOOGLE_OAUTH_CLIENT_ID=cliente.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=PON-AQUI-EL-SECRETO-DEL-CLIENTE-OAUTH-DE-GOOGLE
# GOOGLE_OAUTH_REDIRECT_URI=https://sync.laurafernandezenfermeria.com/auth/google/callback
