{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laural",
  "version": "0.1.0-alpha.19",
  "identifier": "com.laural.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Laural · terminal IA",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' asset: http://asset.localhost data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"]
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/elkangri23/laural/main/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNTVFQkU3QTM3Mzk1MEUKUldRT2xYT2o1K3RWWTF1ZzR2U3R0VVZCL3ppamk5UFg1d2xmRVpWckgvdWlQWjhsaFdibjcrMVQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
